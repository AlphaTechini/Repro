# Copy to .env and fill in. .env is gitignored; never commit real values.

# ---------------------------------------------------------------------------
# Framework (from the Agent-Native chat template)
# ---------------------------------------------------------------------------
# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# ---------------------------------------------------------------------------
# Model provider for Repro's agent (pick ONE; see docs/ARCHITECTURE.md#model)
# The framework reads AGENT_ENGINE and AGENT_MODEL as its default engine.
# ---------------------------------------------------------------------------
# OpenAI (free daily tokens only if your org is enrolled in data sharing)
# AGENT_ENGINE=ai-sdk:openai
# AGENT_MODEL=gpt-5.4-mini
# OPENAI_API_KEY=

# Anthropic (paid per token; the framework's default, best-supported engine)
# AGENT_ENGINE=anthropic
# AGENT_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=

# Google Gemini (free tier key from Google AI Studio)
# AGENT_ENGINE=ai-sdk:google
# AGENT_MODEL=
# GOOGLE_GENERATIVE_AI_API_KEY=

# ---------------------------------------------------------------------------
# GitHub: where Repro files issues
# Fine-grained token with "Issues: Read and write" on GITHUB_REPO only.
# ---------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_REPO=owner/name

# ---------------------------------------------------------------------------
# Capability checks (checks/*.mjs) only
# ---------------------------------------------------------------------------
# 01-llm-tool-call.mjs: openai | anthropic | google, and the model to test.
# Suggested: openai + gpt-5.4-mini, anthropic + claude-haiku-5-5.
# For google, leave CHECK_MODEL empty once and the script lists your models.
CHECK_PROVIDER=openai
CHECK_MODEL=gpt-5.4-mini
CHECK_RUNS=5

# 02-clips-agent-context.mjs: a public Clips share link, or a "Share with agents"
# link. Record it with the Clips Chrome extension on a page with a console error.
CLIPS_SHARE_URL=
