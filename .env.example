# Copy to .env and fill in. .env is gitignored; never commit real values.
# Only deployment-level secrets live here. Per-team settings (which GitHub repo,
# auto-file on/off) are chosen inside the app, not here.

# --- Model for Repro's agent (the framework reads these) ---------------------
AGENT_ENGINE=ai-sdk:openai
AGENT_MODEL=gpt-5.4-mini
OPENAI_API_KEY=

# Alternatives (swap the three lines above):
# AGENT_ENGINE=ai-sdk:google   AGENT_MODEL=<a current Gemini Flash model>   GOOGLE_GENERATIVE_AI_API_KEY=
# AGENT_ENGINE=anthropic       AGENT_MODEL=claude-haiku-5-5                 ANTHROPIC_API_KEY=

# --- The Repro GitHub App (files issues as its own bot) ----------------------
# From the GitHub App's settings page. See docs/SETUP.md. Not needed for the
# capability checks; needed once you test filing issues.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Paste the .pem contents on one line with \n for line breaks.
GITHUB_APP_PRIVATE_KEY=

# --- Framework (from the Agent-Native chat template) -------------------------
PING_MESSAGE=pong
# Production deploys need a stable secret; leave unset for local dev.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true
